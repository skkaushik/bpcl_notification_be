# AI Provider Configuration
AI_PROVIDER=gemini                # "gemini" or "openai"
AI_MODEL=gemini-2.5-flash         # Model name

# API Keys (server-side, optional if client supplies keys)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload
MAX_UPLOAD_SIZE_MB=50

#database
MONGODB_URL= connection_string_here
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@bpcl.in
